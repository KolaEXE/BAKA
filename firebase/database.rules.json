{
  "rules": {
    "users": { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "roomList": {
      ".read": "auth != null",
      "$code": { ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !root.child('presence').child($code).exists() || !root.child('presence').child($code).child(data.child('host').val()).exists())" }
    },
    "rooms": { "$code": { ".read": "auth != null", ".write": "auth != null" } },
    "presence": { ".read": "auth != null", "$code": { "$uid": { ".write": "auth != null && auth.uid === $uid" } } },
    "chat": {
      "$code": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['text','at']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
        }
      }
    }
  }
}
