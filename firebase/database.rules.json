{
  "rules": {
    "users": { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "roomList": {
      ".read": "auth != null",
      "$code": { ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !root.child('presence').child($code).exists())" }
    },
    "rooms": { "$code": { ".read": "auth != null", ".write": "auth != null" } },
    "presence": { ".read": "auth != null", "$code": { "$uid": { ".write": "auth != null && auth.uid === $uid" } } }
  }
}
